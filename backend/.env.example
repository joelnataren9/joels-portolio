# Database provider: firebase | cosmos
DATABASE_PROVIDER=firebase

# Firebase (Firestore) - used when DATABASE_PROVIDER=firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=joels-portfolio-2f583.firebaseapp.com
FIREBASE_PROJECT_ID=joels-portfolio-2f583
FIREBASE_STORAGE_BUCKET=joels-portfolio-2f583.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=719665161324
FIREBASE_APP_ID=1:719665161324:web:1d053ed21e9f6b2ce3e449
FIREBASE_MEASUREMENT_ID=
# Local: path to service account JSON. Azure: prefer FIREBASE_CREDENTIALS_JSON (JSON one line or base64).
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
# Azure App Service / production: full service account JSON or base64(JSON); takes precedence over GOOGLE_APPLICATION_CREDENTIALS in app code.
# FIREBASE_CREDENTIALS_JSON=
FIREBASE_POSTS_COLLECTION=posts
FIREBASE_PROJECTS_COLLECTION=projects

# Admin login: backend verifies Firebase credentials via REST API
FIREBASE_API_KEY=   # Web API Key from Firebase Console → Project settings
# Required: at least 32 chars, e.g. `openssl rand -hex 32`. Admin login returns 503 without it.
JWT_SECRET=
JWT_EXPIRE_HOURS=24
# Required: comma-separated emails allowed to sign in. Empty = nobody (admin login returns 503).
ALLOWED_ADMIN_EMAILS=
